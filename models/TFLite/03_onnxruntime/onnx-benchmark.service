[Unit]
Description=G720 ONNX Neuron Auto Benchmark
After=local-fs.target

[Service]
Type=simple
Environment=RUNS=10
Environment=TIMEOUT_SEC=120
Environment=POLL_SEC=1
Environment=AUTO_REBOOT_ON_OOPS=1
ExecStart=/bin/bash /opt/mtk/ort/benchmark_onnx_watchdog.sh
WorkingDirectory=/opt/mtk/ort
StandardOutput=append:/opt/mtk/ort/benchmark_onnx_service.log
StandardError=append:/opt/mtk/ort/benchmark_onnx_service.log
Restart=no

[Install]
WantedBy=multi-user.target
