# Python 和工具缓存.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/

# 精度评测工作区.
.eval/

# 本地环境和日志.
.env
*.log
logs/
!models/**/results/full_accuracy/**/*.log

# 模型与转换产物.
*.pt
*.pth
*.safetensors
*.torchscript
*.onnx
*.tflite
*.dla
*.bin
*.npy
*.npz
*.zip
*.tar.gz
# 转换生成的运行参数随模型部署,不提交 Git.
models/**/models/quantization.json
# 正在下载的模型
*.crdownload

# ViT 官方权重的本地导出与校验产物.
models/perception/image_classification/vit_base_patch16_224/models/exported/
models/perception/image_classification/vit_base_patch16_224/models/labels.txt
models/perception/image_classification/vit_base_patch16_224/models/imagenet_eval/
models/perception/image_classification/vit_base_patch16_224/models/vit-onnx-float/

# RTMPose 官方权重的本地导出与校验产物.
models/interaction/pose_detection/rtmpose_body2d/models/exported/
models/interaction/pose_detection/rtmpose_body2d/models/rtmpose_body2d.data

# MobileFaceNet 下载的人脸对齐源码和检测权重,已跟踪的模型定义继续保留.
models/interaction/face_recognition/mobilefacenet/models/upstream/

# Depth Anything V2 Small 官方源码、转换产物与运行证据.
models/navigation/single_camera_depth/depth_anything_v2_small/models/upstream/
models/navigation/single_camera_depth/depth_anything_v2_small/models/*.json
models/navigation/single_camera_depth/depth_anything_v2_small/examples/output/runs/

# Whisper-Tiny 官方权重、导出模型与运行证据.
models/audio/stt/whisper_tiny/models/tiny.pt
models/audio/stt/whisper_tiny/models/onnx_manifest.json
models/audio/stt/whisper_tiny/examples/output/runs/

# FastSAM 本地导出、校准与完整性记录.
models/navigation/segmentation/fastsam/models/*.json
models/navigation/segmentation/fastsam/models/runtime_config.csv



